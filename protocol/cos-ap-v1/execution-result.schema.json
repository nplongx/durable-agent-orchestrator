{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cos-ap/1/execution-result",
  "title": "COS Agent Protocol v1 Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "status", "summary", "items"],
  "properties": {
    "batch_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed", "partial"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 32 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task_id", "command", "status", "exit_code", "execution_session_id", "stdout", "stderr", "error"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["COMPLETED", "FAILED", "TIMEOUT", "CANCELLED"] },
          "exit_code": { "type": ["integer", "null"] },
          "execution_session_id": { "type": ["string", "null"] },
          "stdout": { "type": ["string", "null"] },
          "stderr": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
            "then": {
              "properties": {
                "exit_code": { "const": 0 },
                "execution_session_id": { "type": "string", "minLength": 1 },
                "error": { "type": "null" }
              }
            }
          },
          {
            "if": { "properties": { "status": { "const": "FAILED" }, "exit_code": { "const": 0 } }, "required": ["status", "exit_code"] },
            "then": { "properties": { "error": { "type": "string", "minLength": 1, "pattern": "\\S" } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "summary": { "properties": { "passed": { "minimum": 1 }, "failed": { "const": 0 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "summary": { "properties": { "passed": { "const": 0 }, "failed": { "minimum": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": {
        "properties": {
          "summary": { "properties": { "passed": { "minimum": 1 }, "failed": { "minimum": 1 } } }
        }
      }
    }
  ]
}
